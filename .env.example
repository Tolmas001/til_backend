# App
NODE_ENV=development
PORT=3000

# Database
DATABASE_URL=postgresql://postgres:password@localhost:5432/rustiliai

# JWT
JWT_SECRET=your-super-secret-key
JWT_EXPIRES_IN=7d

# OpenAI
OPENAI_API_KEY=sk-...

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback

# Frontend
FRONTEND_URL=http://localhost:3001

# Redis
REDIS_URL=redis://localhost:6379

# Logging
LOG_LEVEL=debug

# Sentry Error Monitoring
SENTRY_DSN=

# Telegram Bot (for Telegram Web App integration)
TELEGRAM_BOT_TOKEN=
